---
import AppLayout from '../../../layouts/AppLayout.astro';
import StatCard from '../../../components/app/StatCard.astro';
import { getAuthUser } from '../../../lib/auth';
import { listarAlunosDoPersonal } from '../../../lib/queries';

const user = getAuthUser(Astro.cookies);
if (!user || (user.role !== 'personal' && user.role !== 'admin')) {
  return Astro.redirect('/app', 302);
}

const alunos = await listarAlunosDoPersonal(user.id);

const totalTreinos = alunos.reduce((acc, a) => acc + a.totalTreinos, 0);
const comAnamnese = alunos.filter((a) => a.temAnamnese).length;
const ativosEsteMes = alunos.filter((a) => a.totalSessoes > 0).length;

const fmtData = (iso: string | null) =>
  iso
    ? new Date(iso + 'T12:00:00Z').toLocaleDateString('pt-BR', {
        day: '2-digit',
        month: 'short',
        timeZone: 'UTC',
      })
    : 'Nenhuma';
---
<AppLayout ativo="personal_alunos" title="Painel do Treinador | Academia">
  <header class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#DC2626]/20 text-red-400 border border-red-500/30">
          Treinador Certificado
        </span>
        <span class="text-xs text-zinc-400">CREF 128477-G/SP</span>
      </div>
      <h1 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-white" style="font-family: Oswald, sans-serif">
        Olá, Prof. {user.nome.split(' ')[0]}
      </h1>
      <p class="mt-1 text-sm text-zinc-400">
        Gestão de alunos, prescrição de rotinas e acompanhamento da evolução física.
      </p>
    </div>

    <div class="flex items-center gap-3">
      <a
        href="/app/personal/treino/novo"
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#DC2626] to-[#F97316] text-white text-sm font-bold shadow-lg shadow-red-950/40 hover:brightness-110 transition active:scale-[0.99]"
      >
        + Prescrever Treino
      </a>
    </div>
  </header>

  <!-- Indicadores do Treinador -->
  <section aria-labelledby="indicadores-personal" class="mb-10">
    <h2 id="indicadores-personal" class="sr-only">Indicadores da consultoria</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <StatCard rotulo="Alunos Ativos" valor={alunos.length} detalhe="sob sua prescrição" destaque={true} />
      <StatCard rotulo="Fichas Montadas" valor={totalTreinos} detalhe="rotinas cadastradas" />
      <StatCard rotulo="Anamneses LGPD" valor={`${comAnamnese} de ${alunos.length}`} detalhe="fichas clínicas prontas" />
      <StatCard rotulo="Alunos em Atividade" valor={ativosEsteMes} detalhe="com treinos registrados" />
    </div>
  </section>

  <!-- Lista de Alunos -->
  <section aria-labelledby="titulo-alunos" class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 id="titulo-alunos" class="text-xl font-bold tracking-tight text-white flex items-center gap-2">
        <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#DC2626] text-white text-xs font-black">
          ✓
        </span>
        Seus Alunos ({alunos.length})
      </h2>
    </div>

    {alunos.length === 0 ? (
      <div class="p-12 text-center bg-white/[0.02] border border-white/10 rounded-2xl text-zinc-400">
        Nenhum aluno vinculado no momento.
      </div>
    ) : (
      <div class="grid gap-4 md:grid-cols-2">
        {alunos.map((a) => (
          <article class="bg-white/[0.03] border border-white/10 hover:border-white/20 rounded-2xl p-6 transition flex flex-col justify-between gap-6">
            <div class="space-y-4">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="h-11 w-11 rounded-full bg-gradient-to-br from-[#DC2626] to-[#F97316] flex items-center justify-center text-white font-black text-base shrink-0">
                    {a.nome.charAt(0)}
                  </div>
                  <div>
                    <h3 class="font-bold text-white text-base leading-snug">{a.nome}</h3>
                    <p class="text-xs text-zinc-400">{a.email}</p>
                  </div>
                </div>

                {a.temAnamnese ? (
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-950/60 text-emerald-400 border border-emerald-500/30">
                    Anamnese OK
                  </span>
                ) : (
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-950/60 text-amber-400 border border-amber-500/30">
                    Sem Anamnese
                  </span>
                )}
              </div>

              <div class="grid grid-cols-2 gap-2 text-xs py-3 border-y border-white/5">
                <div>
                  <span class="text-zinc-500 block">Fichas ativas:</span>
                  <span class="text-zinc-200 font-semibold">{a.totalTreinos} treinos</span>
                </div>
                <div>
                  <span class="text-zinc-500 block">Última sessão:</span>
                  <span class="text-zinc-200 font-semibold">{fmtData(a.ultimaSessao)}</span>
                </div>
              </div>

              {a.treinos.length > 0 && (
                <div class="space-y-1.5">
                  <span class="text-[11px] uppercase tracking-wider text-zinc-500 font-semibold">Rotinas cadastradas:</span>
                  <div class="flex flex-wrap gap-1.5">
                    {a.treinos.map((t) => (
                      <span class="px-2 py-0.5 rounded bg-white/5 text-zinc-300 text-xs font-medium">
                        {t.nome}
                      </span>
                    ))}
                  </div>
                </div>
              )}
            </div>

            <div class="flex items-center gap-2 pt-2 border-t border-white/5">
              <a
                href={`/app/personal/aluno/${a.id}`}
                class="flex-1 py-2 px-3 rounded-xl bg-white/10 hover:bg-white/15 text-center text-xs font-semibold text-white transition"
              >
                Ver Ficha & Histórico
              </a>
              <a
                href={`/app/personal/treino/novo?alunoId=${a.id}`}
                class="py-2 px-3 rounded-xl bg-[#DC2626]/20 hover:bg-[#DC2626]/30 text-red-300 border border-red-500/30 text-center text-xs font-semibold transition"
              >
                + Montar Treino
              </a>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</AppLayout>
