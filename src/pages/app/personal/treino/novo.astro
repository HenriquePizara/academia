---
import AppLayout from '../../../../layouts/AppLayout.astro';
import TreinoBuilder from '../../../../components/personal/TreinoBuilder';
import { getAuthUser } from '../../../../lib/auth';
import { listarAlunosDoPersonal, listarExerciciosCatalogo } from '../../../../lib/queries';

const user = getAuthUser(Astro.cookies);
if (!user || (user.role !== 'personal' && user.role !== 'admin')) {
  return Astro.redirect('/app', 302);
}

const alunoIdParam = Astro.url.searchParams.get('alunoId') || undefined;

const [alunos, exercicios] = await Promise.all([
  listarAlunosDoPersonal(user.id),
  listarExerciciosCatalogo(),
]);

const alunosOptions = alunos.map((a) => ({
  id: a.id,
  nome: a.nome,
  email: a.email,
}));

const exerciciosOptions = exercicios.map((e) => ({
  id: e.id,
  nome: e.nome,
  grupoMuscular: e.grupoMuscular,
  descricao: e.descricao,
}));
---
<AppLayout ativo="personal_novo" title="Prescrever Treino | Academia">
  <div class="mb-6">
    <a href="/app/personal" class="text-xs font-semibold text-zinc-400 hover:text-white transition flex items-center gap-1.5">
      ← Voltar ao Painel
    </a>
  </div>

  <header class="mb-8 pb-6 border-b border-white/10">
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#DC2626]/20 text-red-400 border border-red-500/30">
        Prescrição Técnica
      </span>
      <span class="text-xs text-zinc-400">CREF 128477-G/SP</span>
    </div>
    <h1 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-white" style="font-family: Oswald, sans-serif">
      Montar Ficha de Treino
    </h1>
    <p class="mt-1 text-sm text-zinc-400">
      Selecione o aluno, defina os exercícios do catálogo e ajuste o volume (séries, repetições, carga e descanso).
    </p>
  </header>

  <TreinoBuilder
    client:load
    alunos={alunosOptions}
    exercicios={exerciciosOptions}
    alunoPreselecionadoId={alunoIdParam}
  />
</AppLayout>
