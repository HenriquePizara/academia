---
import AppLayout from '../../../../layouts/AppLayout.astro';
import { getAuthUser } from '../../../../lib/auth';
import { getAlunoDetalhes } from '../../../../lib/queries';

const user = getAuthUser(Astro.cookies);
if (!user || (user.role !== 'personal' && user.role !== 'admin')) {
  return Astro.redirect('/app', 302);
}

const { id } = Astro.params;
if (!id) return Astro.redirect('/app/personal', 302);

const dados = await getAlunoDetalhes(id, user.id);
if (!dados) return Astro.redirect('/app/personal', 302);

const { aluno, anamnese, treinos, ultimasExecucoes } = dados;

const respostasAnamnese = anamnese ? (anamnese.respostas as Record<string, string>) : null;

const fmtData = (iso: string | null) =>
  iso
    ? new Date(iso + 'T12:00:00Z').toLocaleDateString('pt-BR', {
        day: '2-digit',
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      })
    : 'Nunca';
---
<AppLayout ativo="personal_alunos" title={`${aluno.nome} | Perfil do Aluno`}>
  <div class="mb-6">
    <a href="/app/personal" class="text-xs font-semibold text-zinc-400 hover:text-white transition flex items-center gap-1.5">
      ← Voltar aos Alunos
    </a>
  </div>

  <header class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6 border-b border-white/10">
    <div class="flex items-center gap-4">
      <div class="h-16 w-16 rounded-2xl bg-gradient-to-br from-[#DC2626] to-[#F97316] flex items-center justify-center text-white font-black text-2xl shrink-0 shadow-lg shadow-red-950/40">
        {aluno.nome.charAt(0)}
      </div>
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white" style="font-family: Oswald, sans-serif">
          {aluno.nome}
        </h1>
        <p class="text-sm text-zinc-400">{aluno.email} • Membro desde {new Date(aluno.createdAt).toLocaleDateString('pt-BR')}</p>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <a
        href={`/app/personal/treino/novo?alunoId=${aluno.id}`}
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#DC2626] to-[#F97316] text-white text-sm font-bold shadow-lg shadow-red-950/40 hover:brightness-110 transition active:scale-[0.99]"
      >
        + Nova Ficha de Treino
      </a>
    </div>
  </header>

  <div class="grid gap-8 lg:grid-cols-3">
    <!-- Coluna Esquerda: Anamnese e Dados Clínicos -->
    <div class="lg:col-span-1 space-y-6">
      <section class="bg-white/[0.03] border border-white/10 rounded-2xl p-6 space-y-4">
        <h2 class="text-base font-bold text-white flex items-center gap-2">
          <span class="flex h-6 w-6 items-center justify-center rounded-md bg-[#DC2626] text-white text-xs font-black">
            📋
          </span>
          Anamnese & Saúde (LGPD)
        </h2>

        {respostasAnamnese ? (
          <div class="space-y-3.5 text-xs">
            {Object.entries(respostasAnamnese).map(([pergunta, resposta]) => (
              <div class="bg-[#141414] border border-white/5 rounded-xl p-3">
                <p class="font-semibold text-zinc-400 uppercase tracking-wider text-[10px] mb-1">
                  {pergunta}
                </p>
                <p class="text-zinc-200 text-xs leading-relaxed">{resposta || 'Não informado'}</p>
              </div>
            ))}
          </div>
        ) : (
          <div class="p-6 text-center border border-dashed border-white/15 rounded-xl text-zinc-400 text-xs">
            <p>O aluno ainda não preencheu a ficha de anamnese.</p>
            <p class="mt-1 text-zinc-500">Oriente o aluno a preencher em Minha Conta &gt; Anamnese.</p>
          </div>
        )}
      </section>

      <!-- Resumo de Adesão -->
      <section class="bg-white/[0.03] border border-white/10 rounded-2xl p-6 space-y-3">
        <h2 class="text-base font-bold text-white">Métricas de Frequência</h2>
        <div class="grid grid-cols-2 gap-3 text-xs">
          <div class="bg-[#141414] border border-white/5 rounded-xl p-3 text-center">
            <span class="block text-zinc-500 text-[11px]">Rotinas Ativas</span>
            <span class="text-lg font-bold text-white">{treinos.length}</span>
          </div>
          <div class="bg-[#141414] border border-white/5 rounded-xl p-3 text-center">
            <span class="block text-zinc-500 text-[11px]">Sessões Realizadas</span>
            <span class="text-lg font-bold text-emerald-400">{ultimasExecucoes.length}</span>
          </div>
        </div>
      </section>
    </div>

    <!-- Coluna Direita: Fichas de Treino e Histórico -->
    <div class="lg:col-span-2 space-y-8">
      <!-- Fichas de Treino Prescritas -->
      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <span class="flex h-6 w-6 items-center justify-center rounded-md bg-[#DC2626] text-white text-xs font-black">
              🏋️
            </span>
            Fichas de Treino Prescritas ({treinos.length})
          </h2>
        </div>

        {treinos.length === 0 ? (
          <div class="p-8 text-center bg-white/[0.02] border border-dashed border-white/15 rounded-2xl text-zinc-400 text-sm">
            Nenhuma ficha cadastrada para este aluno.
            <div class="mt-3">
              <a
                href={`/app/personal/treino/novo?alunoId=${aluno.id}`}
                class="inline-block px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 text-white text-xs font-semibold transition"
              >
                + Montar Primeira Ficha
              </a>
            </div>
          </div>
        ) : (
          <div class="space-y-3">
            {treinos.map((t) => (
              <article class="bg-white/[0.03] border border-white/10 rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="space-y-1">
                  <h3 class="font-bold text-white text-base">{t.nome}</h3>
                  {t.observacoes && (
                    <p class="text-xs text-zinc-400 max-w-[50ch]">{t.observacoes}</p>
                  )}
                  <p class="text-[11px] text-zinc-500">
                    Última execução pelo aluno: <strong class="text-zinc-300">{fmtData(t.ultimaExecucao?.dataExecucao ?? null)}</strong> • {t.concluidas} execuções no histórico
                  </p>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                  <a
                    href={`/app/treino/${t.id}`}
                    class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/15 text-xs font-semibold text-white transition"
                  >
                    Visualizar Ficha
                  </a>
                  <button
                    type="button"
                    data-treino-id={t.id}
                    class="btn-excluir-treino px-3 py-1.5 rounded-lg bg-red-950/40 hover:bg-red-900/60 border border-red-500/30 text-xs font-semibold text-red-300 transition"
                  >
                    Excluir
                  </button>
                </div>
              </article>
            ))}
          </div>
        )}
      </section>

      <!-- Últimas Sessões Concluídas -->
      <section class="space-y-4">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span class="flex h-6 w-6 items-center justify-center rounded-md bg-[#DC2626] text-white text-xs font-black">
            ⏱
          </span>
          Histórico Recente de Execuções ({ultimasExecucoes.length})
        </h2>

        {ultimasExecucoes.length === 0 ? (
          <div class="p-6 text-center bg-white/[0.02] border border-white/10 rounded-xl text-zinc-400 text-xs">
            Nenhuma sessão registrada pelo aluno até o momento.
          </div>
        ) : (
          <div class="overflow-x-auto border border-white/10 rounded-2xl bg-white/[0.02]">
            <table class="w-full text-left text-xs text-zinc-300">
              <thead class="bg-white/5 text-[11px] uppercase tracking-wider text-zinc-400 border-b border-white/10">
                <tr>
                  <th class="py-3 px-4 font-semibold">Data</th>
                  <th class="py-3 px-4 font-semibold">Treino</th>
                  <th class="py-3 px-4 font-semibold">Carga Acumulada</th>
                  <th class="py-3 px-4 font-semibold">Status</th>
                  <th class="py-3 px-4 font-semibold">Observações</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5">
                {ultimasExecucoes.map((e) => (
                  <tr class="hover:bg-white/[0.02]">
                    <td class="py-3 px-4 font-medium text-white">{fmtData(e.dataExecucao)}</td>
                    <td class="py-3 px-4">{e.treinoNome}</td>
                    <td class="py-3 px-4">{e.cargaReal ? `${Number(e.cargaReal).toLocaleString('pt-BR')} kg` : '—'}</td>
                    <td class="py-3 px-4">
                      {e.concluido ? (
                        <span class="text-emerald-400 font-semibold">Concluído</span>
                      ) : (
                        <span class="text-zinc-500">Parcial</span>
                      )}
                    </td>
                    <td class="py-3 px-4 text-zinc-400 max-w-[200px] truncate">{e.observacao || '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    </div>
  </div>

  <script is:inline>
    document.querySelectorAll('.btn-excluir-treino').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = btn.getAttribute('data-treino-id');
        if (!id) return;
        if (!confirm('Deseja realmente excluir esta ficha de treino? As execuções associadas também serão removidas.')) {
          return;
        }

        try {
          const res = await fetch(`/api/personal/treinos?id=${id}`, { method: 'DELETE' });
          if (!res.ok) {
            const data = await res.json();
            alert(data.error || 'Erro ao excluir');
            return;
          }
          window.location.reload();
        } catch {
          alert('Erro de conexão ao excluir');
        }
      });
    });
  </script>
</AppLayout>
