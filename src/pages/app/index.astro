---
import AppLayout from '../../layouts/AppLayout.astro';
import StatCard from '../../components/app/StatCard.astro';
import VolumeChart from '../../components/app/VolumeChart.astro';
import FrequenciaChart from '../../components/app/FrequenciaChart.astro';
import { getAuthUser } from '../../lib/auth';
import { listarTreinosDoAluno, metricasEvolucao } from '../../lib/queries';

const user = getAuthUser(Astro.cookies);
if (!user) return Astro.redirect('/login', 302);

const [treinos, metricas] = await Promise.all([
  listarTreinosDoAluno(user.id),
  metricasEvolucao(user.id, 8),
]);

const hoje = new Date().toLocaleDateString("pt-BR", {
  weekday: "long",
  day: "2-digit",
  month: "long",
  timeZone: "UTC",
});

const fmtData = (iso: string | null) =>
  iso
    ? new Date(iso + "T12:00:00Z").toLocaleDateString("pt-BR", {
        day: "2-digit",
        month: "short",
        timeZone: "UTC",
      })
    : 'nunca';
---
<AppLayout ativo="treino" title="Meus treinos | Academia">
  <header class="mb-8">
    <p class="text-sm text-zinc-400 capitalize">{hoje}</p>
    <h1 class="mt-1 text-3xl sm:text-4xl font-bold tracking-tight text-white" style="font-family: Oswald, sans-serif">
      Olá, {user.nome.split(" ")[0]}
    </h1>
    <p class="mt-2 max-w-[60ch] text-zinc-300">
      Sua ficha de treino, seu histórico e sua evolução — tudo em um lugar só.
    </p>
  </header>

  <section aria-labelledby="titulo-indicadores" class="mb-8">
    <h2 id="titulo-indicadores" class="sr-only">Indicadores</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <StatCard rotulo="Sequência" valor={metricas.streak + " dias"} detalhe="dias seguidos de treino" destaque={metricas.streak > 0} />
      <StatCard rotulo="Sessões" valor={metricas.sessoesConcluidas} detalhe="concluídas em 8 semanas" />
      <StatCard rotulo="Volume médio" valor={metricas.volumeMedio.toLocaleString("pt-BR") + " kg"} detalhe="por semana ativa" />
      <StatCard rotulo="Último treino" valor={fmtData(metricas.ultimoTreino?.data ?? null)} detalhe={metricas.ultimoTreino?.nome ?? "sem registros"} />
    </div>
  </section>

  <section aria-labelledby="titulo-treinos" class="mb-10">
    <h2 id="titulo-treinos" class="mb-4 text-sm font-bold tracking-[0.14em] text-white uppercase">Sua ficha de treino</h2>
    {treinos.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-white/15 px-6 py-14 text-center">
        <h3 class="text-lg font-bold text-white">Nenhum treino atribuído ainda</h3>
        <p class="mt-2 mx-auto max-w-[46ch] text-sm leading-6 text-zinc-400">
          Seu personal trainer monta a ficha no sistema. Assim que estiver pronta, ela aparece aqui e você
          começa a registrar as sessões direto pelo celular.
        </p>
        <a
          href="https://wa.me/551194708842?text=Ol%C3%A1!%20Quero%20saber%20mais%20sobre%20meu%20treino."
          target="_blank"
          rel="noopener"
          class="mt-6 inline-flex h-12 items-center justify-center rounded-lg bg-[#DC2626] px-6 text-sm font-bold text-white hover:bg-[#B91C1C] transition"
        >
          Falar com o personal
        </a>
      </div>
    ) : (
      <ul class="grid gap-4 sm:grid-cols-2">
        {treinos.map((t) => (
          <li>
            <a
              href={"/app/treino/" + t.id}
              class="block h-full rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition hover:border-[#DC2626]/60 hover:bg-white/[0.05]"
            >
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <h3 class="text-lg font-bold text-white">{t.nome}</h3>
                  <p class="mt-1 text-sm text-zinc-400">Personal: {t.personalNome}</p>
                </div>
                {t.feitoHoje && (
                  <span class="shrink-0 rounded-full border border-emerald-500/40 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-300">
                    Feito hoje
                  </span>
                )}
              </div>
              {t.observacoes && <p class="mt-3 text-sm leading-5 text-zinc-300">{t.observacoes}</p>}
              <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-1 border-t border-white/10 pt-3 text-sm">
                <div class="flex gap-1.5">
                  <dt class="text-zinc-400">Sessões</dt>
                  <dd class="font-semibold text-white tabular-nums">{t.concluidas}</dd>
                </div>
                <div class="flex gap-1.5">
                  <dt class="text-zinc-400">Última</dt>
                  <dd class="font-semibold text-white tabular-nums">{fmtData(t.ultimaExecucao?.dataExecucao ?? null)}</dd>
                </div>
              </dl>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section aria-labelledby="titulo-graficos" class="grid gap-4 lg:grid-cols-2">
    <h2 id="titulo-graficos" class="sr-only">Gráficos de evolução</h2>
    <VolumeChart semanas={metricas.semanas} />
    <FrequenciaChart semanas={metricas.semanas} />
  </section>
</AppLayout>
